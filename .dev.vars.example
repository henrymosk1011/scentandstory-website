# Copy to .dev.vars for local testing with `npm run dev`. Never commit .dev.vars.
# In production set it with:  npx wrangler secret put RESEND_API_KEY
RESEND_API_KEY=re_your_key_here

# Cloudflare's always pass Turnstile test secret. The real widget does not allow
# localhost, so run the dev server with the matching test site key:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA npm run dev
# In production set the real secret with:  npx wrangler secret put TURNSTILE_SECRET_KEY
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
